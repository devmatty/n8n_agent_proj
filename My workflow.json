    {
      "parameters": {
        "language": "pythonNative",
        "pythonCode": "# Score each account 1-5 using the same logic as tools.py\n# Output ONLY accounts that score 4 or higher (need outreach)\n\nscored = []\n\nfor item in _items:\n    a = item[\"json\"]\n    score = 1\n    reasons = []\n\n    # Real signal: CSAT\n    csat = float(a.get(\"avg_satisfaction\") or 0)\n    if csat and csat <= 2.7:\n        score += 2\n        reasons.append(f\"low CSAT ({csat})\")\n    elif csat and csat <= 3.0:\n        score += 1\n        reasons.append(f\"soft CSAT ({csat})\")\n\n    # Real signal: critical-ticket rate\n    crit_rate = float(a.get(\"critical_rate\") or 0)\n    if crit_rate >= 0.50:\n        score += 1\n        reasons.append(f\"critical rate {int(crit_rate*100)}%\")\n\n    # Real signal: open ticket volume\n    open_tickets = int(a.get(\"open_tickets\") or 0)\n    if open_tickets >= 150:\n        score += 1\n        reasons.append(f\"{open_tickets} open tickets\")\n\n    # Synthetic signal: renewal proximity\n    days_to_renewal = int(a.get(\"days_to_renewal__SYNTH\") or 999)\n    if days_to_renewal <= 45:\n        score += 1\n        reasons.append(f\"renewal in {days_to_renewal} days\")\n\n    # Cap at 5\n    score = min(score, 5)\n\n    # Attach the score to the account\n    a[\"risk_score\"] = score\n    a[\"risk_reason\"] = \"; \".join(reasons) if reasons else \"no risk signals\"\n\n    # Only keep accounts that need outreach\n    if score >= 4:\n        scored.append({\"json\": a})\n\nreturn scored"
      },
